# Shared
AUDIO_SECONDS=5

# Local client config
REMOTE_API_URL=http://127.0.0.1:8080/chat
SAMPLE_RATE=16000

# Remote API server config
API_HOST=0.0.0.0
API_PORT=8080
WHISPER_COMMAND=whisper-cli --model base.en --file "{audio_path}" --output-txt --output-file "{out_prefix}"
OLLAMA_MODEL=llama3.1
SYSTEM_PROMPT=You are a concise assistant.
