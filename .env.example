# Shared
REMOTE_API_URL=http://127.0.0.1:8080/chat
REMOTE_STREAM_API_URL=http://127.0.0.1:8080/chat/stream
REMOTE_TTS_API_URL=http://127.0.0.1:8080/tts
SESSION_ID=default
SAMPLE_RATE=16000
REALTIME_BLOCK_MS=30
REALTIME_RMS_THRESHOLD=450
REALTIME_MIN_SPEECH_SECONDS=0.35
REALTIME_SILENCE_SECONDS=0.8
REALTIME_PRE_ROLL_SECONDS=0.2
REALTIME_MAX_UTTERANCE_SECONDS=12.0
TTS_ENABLED=true
DUCK_MIC_WHILE_PLAYBACK=false

# Remote API server config
API_HOST=0.0.0.0
API_PORT=8080
WHISPER_MODEL_PATH=models/ggml-base.en.bin
WHISPER_COMMAND=whisper-cli -m "{whisper_model_path}" -f "{audio_path}" -otxt -of "{out_prefix}"
OLLAMA_MODEL=llama3.1
OLLAMA_API_URL=http://127.0.0.1:11434
SYSTEM_PROMPT=You are a concise assistant.
CONTEXT_WINDOW_TURNS=6
DEFAULT_SESSION_ID=default
TTS_RATE=185
TTS_COMMAND=espeak-ng -s {rate} --stdout {text}
